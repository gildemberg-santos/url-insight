# Caminho do arquivo SQLite. Sem isso, usa :memory: (dados perdidos ao reiniciar).
URLINSIGHT_DB=url-insight.db
# Se definido, /shorten, /analytics e /show-data exigem "Authorization: Bearer <token>".
URLINSIGHT_ADMIN_TOKEN=
# IDs de tracking. Se vazios, os scripts correspondentes não são carregados.
URLINSIGHT_GA_ID=
URLINSIGHT_FB_PIXEL_ID=
# E-mail exibido na política de privacidade para pedidos de titulares (LGPD).
URLINSIGHT_CONTACT_EMAIL=
